<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network permissions -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Audio recording permission -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Account management permissions (legacy, max SDK 22) -->
    <uses-permission
        android:name="android.permission.AUTHENTICATE_ACCOUNTS"
        android:maxSdkVersion="22" />
    <uses-permission
        android:name="android.permission.GET_ACCOUNTS"
        android:maxSdkVersion="22" />
    <uses-permission
        android:name="android.permission.MANAGE_ACCOUNTS"
        android:maxSdkVersion="22" />

    <!-- Notification permission for Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground service permission for Android 14+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Android 16 specific permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Privacy-preserving permissions for Android 16 -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Enhanced security permissions for Android 16 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />


    <application
        android:name=".Spell4WikiApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:configChanges="locale"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config"
        android:extractNativeLibs="false"
        tools:ignore="GoogleAppIndexingWarning"
        tools:targetApi="35">



        <!-- Splash Activity (Main Launcher) -->
        <activity
            android:name="com.manimarank.spell4wiki.ui.compose.splash.SplashActivity"
            tools:ignore="LockedOrientationActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.FullScreen"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- App Intro Activity -->
        <activity android:name="com.manimarank.spell4wiki.ui.compose.intro.AppIntroActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:theme="@style/AppTheme.FullScreen"/>



        <!-- Settings Activity -->
        <activity android:name="com.manimarank.spell4wiki.ui.compose.settings.SettingsActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:theme="@style/AppTheme.NoActionBar"/>

        <!-- About Activity -->
        <activity android:name="com.manimarank.spell4wiki.ui.compose.about.AboutActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:theme="@style/AppTheme.NoActionBar"/>

        <!-- Contributors Activity -->
        <activity android:name="com.manimarank.spell4wiki.ui.compose.contributors.ContributorsActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:theme="@style/AppTheme.NoActionBar"/>

        <!-- Spell4Word Activity -->
        <activity android:name="com.manimarank.spell4wiki.ui.compose.spell4word.Spell4WordActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:theme="@style/AppTheme.NoActionBar"/>

        <!-- Spell4WordList Activity -->
        <activity android:name="com.manimarank.spell4wiki.ui.compose.spell4wordlist.Spell4WordListActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:theme="@style/AppTheme.NoActionBar"/>



        <!-- Login Activity -->
        <activity
            android:name="com.manimarank.spell4wiki.ui.compose.auth.LoginActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            tools:ignore="LockedOrientationActivity" />

        <activity
            android:name="com.manimarank.spell4wiki.ui.compose.spell4wiktionary.Spell4WiktionaryActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="false" />



        <activity
            android:name="com.manimarank.spell4wiki.ui.about.ListItemActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:theme="@style/AppTheme" />



        <activity
            android:name="com.manimarank.spell4wiki.ui.webui.CommonWebActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:theme="@style/AppTheme.NoActionBar" />


        <activity
            android:name="com.manimarank.spell4wiki.ui.recordaudio.RecordAudioActivity"
            android:screenOrientation="unspecified"
            tools:ignore="LockedOrientationActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:theme="@style/RecordAudioDialogTheme" />

        <!-- Language Selection Activity -->
        <activity
            android:name="com.manimarank.spell4wiki.ui.compose.languageselection.LanguageSelectionActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name="com.manimarank.spell4wiki.ui.compose.recording.RecordAudioComposeActivity"
            android:screenOrientation="unspecified"
            tools:ignore="LockedOrientationActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:theme="@style/RecordAudioDialogTheme" />

        <activity
            android:name="com.manimarank.spell4wiki.ui.webui.CommonWebContentActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:theme="@style/AppTheme" />
        <activity
            android:name="com.manimarank.spell4wiki.ui.compose.webview.WebContentActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:theme="@style/AppTheme" />

        <activity
            android:name="com.manimarank.spell4wiki.ui.compose.main.MainActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:theme="@style/AppTheme" />

        <activity
            android:name="com.manimarank.spell4wiki.ui.compose.search.SearchActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:theme="@style/AppTheme" />

        <service android:name=".data.auth.WikiAuthenticatorService"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/wikimedia_authenticator" />
        </service>
    </application>

</manifest>